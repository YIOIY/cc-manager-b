# /etc/cc-manager/cc-manager.env  (mode 0600, owner root)
CC_MANAGER_LISTEN=127.0.0.1:18080
CC_MANAGER_DB=/var/lib/cc-manager/cc-manager.db
CC_MANAGER_WEB_DIR=/opt/cc-manager/current/web/dist
CC_MANAGER_ADMIN_USER=admin
# Preferred: argon2id hash from `cc-manager hash-password`
# Wrap the hash in single quotes: Docker Compose would otherwise expand every "$".
# CC_MANAGER_ADMIN_PASSWORD_HASH='$argon2id$v=19$m=65536,t=3,p=2$...'
CC_MANAGER_ADMIN_PASSWORD=change-this-before-start
# openssl rand -base64 32  -- back this up separately from the database
CC_MANAGER_ENCRYPTION_KEY=base64-of-32-random-bytes
# nginx sets X-Forwarded-Proto/Host, so cookies can be marked Secure
CC_MANAGER_TRUST_PROXY=1
CC_MANAGER_LOG_LEVEL=info
# CC_MANAGER_BILL_MAX_ITEMS=10000
# CC_MANAGER_SUPPLIER_TLS_PINS={"host:443":"sha256-hex"}
# 访问供应商使用的代理；留空为直连。供应商请求不读取 HTTP_PROXY / HTTPS_PROXY。
# 支持 http://、https://、socks5://、socks5h://，格式错误时服务拒绝启动。
# CC_MANAGER_SUPPLIER_PROXY=http://proxy.internal:3128
