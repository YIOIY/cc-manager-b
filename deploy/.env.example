# Copy to deploy/.env for docker compose. Never commit the real file.
CC_MANAGER_ADMIN_USER=admin
# Preferred: an argon2id hash produced by `cc-manager hash-password`.
# CC_MANAGER_ADMIN_PASSWORD_HASH=$argon2id$v=19$m=65536,t=3,p=2$...
# Fallback: a plaintext password of at least 12 characters.
CC_MANAGER_ADMIN_PASSWORD=change-this-before-start
# 32 random bytes, base64: openssl rand -base64 32
CC_MANAGER_ENCRYPTION_KEY=base64-of-32-random-bytes
# Set to 1 only behind a trusted reverse proxy that sets X-Forwarded-Proto/Host.
CC_MANAGER_TRUST_PROXY=0
# Optional tuning
# CC_MANAGER_LOG_LEVEL=info
# CC_MANAGER_BILL_MAX_ITEMS=10000
# CC_MANAGER_BILL_INTERVAL_MS=1000
# CC_MANAGER_SUPPLIER_TLS_PINS={"host:443":"sha256-hex-of-leaf-certificate"}
# 访问供应商使用的代理；留空为直连。供应商请求不读取 HTTP_PROXY / HTTPS_PROXY。
# 支持 http://、https://、socks5://、socks5h://，格式错误时服务拒绝启动。
# CC_MANAGER_SUPPLIER_PROXY=http://proxy.internal:3128
# CC_MANAGER_SUPPLIER_INSECURE_TLS=0
