#!/bin/sh
# Stops the mistakes that are expensive to undo once pushed: database files,
# key material and tokens. Enabled by `make setup`. See CONTRIBUTING.md §8.
fail=0
staged=$(git diff --cached --name-only --diff-filter=ACMR)
[ -n "$staged" ] || exit 0

# 1. Files that must never be committed, even with `git add -f`.
bad=$(printf '%s\n' "$staged" | grep -E '(^|/)\.local-run/|\.(db|db-shm|db-wal|sqlite|pem|key|p12|pfx)$|(^|/)\.env(\..*)?$|\.env$|(^|/)id_(rsa|ed25519)' | grep -v '\.env\.example$' || true)
if [ -n "$bad" ]; then
    echo "pre-commit: 这些文件不允许提交（数据库、密钥或本地配置）：" >&2
    printf '  %s\n' $bad >&2
    fail=1
fi

# 2. Added lines that look like credentials.
hits=$(git diff --cached -U0 --diff-filter=ACMR -- . ':(exclude).githooks/pre-commit' | grep -E '^\+[^+]' | grep -E -e '-----BEGIN [A-Z ]*PRIVATE KEY-----' -e 'gh[pousr]_[A-Za-z0-9]{30,}' -e 'github_pat_[A-Za-z0-9_]{30,}' -e 'sk-ant-[A-Za-z0-9_-]{20,}' -e 'AKIA[0-9A-Z]{16}' -e 'xox[baprs]-[A-Za-z0-9-]{10,}' || true)
if [ -n "$hits" ]; then
    echo "pre-commit: 暂存的改动里有疑似密钥或令牌：" >&2
    printf '%s\n' "$hits" | cut -c1-60 | sed 's/^/  /' >&2
    echo "  如果已经推送过，立刻告诉维护者：密钥需要作废重发。" >&2
    fail=1
fi

# 3. Auto-format Go (same as CI gofmt check).
gofiles=$(printf '%s\n' "$staged" | grep -E '\.go$' || true)
if [ -n "$gofiles" ] && command -v gofmt >/dev/null 2>&1; then
    # shellcheck disable=SC2086
    gofmt -w $gofiles 2>/dev/null || true
    # shellcheck disable=SC2086
    git add $gofiles
    unformatted=$(gofmt -l $gofiles 2>/dev/null || true)
    if [ -n "$unformatted" ]; then
        echo "pre-commit: 这些 Go 文件无法自动格式化：" >&2
        printf '  %s\n' $unformatted >&2
        fail=1
    fi
fi

# 4. Auto-format frontend with Prettier (same as CI format:check).
webfiles=$(printf '%s\n' "$staged" | grep -E '^web/.*\.(vue|ts|tsx|js|jsx|mjs|cjs|json|css|md|yml|yaml)$' || true)
if [ -n "$webfiles" ]; then
    prettier=web/node_modules/.bin/prettier
    if [ ! -x "$prettier" ]; then
        echo "pre-commit: 缺少 web/node_modules，先执行 make web-install" >&2
        fail=1
    else
        pick_node() {
            is_ok() {
                bin=$1
                [ -x "$bin" ] || return 1
                major=$("$bin" -p "process.versions.node.split('.')[0]" 2>/dev/null) || return 1
                [ "$major" -ge 18 ]
            }
            candidate=$(command -v node 2>/dev/null || true)
            if [ -n "$candidate" ] && is_ok "$candidate"; then
                printf '%s\n' "$candidate"
                return 0
            fi
            for root in "${NVM_DIR:-}" "${HOME}/.nvm" /usr/local/opt/nvm; do
                [ -n "$root" ] && [ -d "$root/versions/node" ] || continue
                for bin in $(ls -1d "$root/versions/node"/v*/bin/node 2>/dev/null | sort -V -r); do
                    if is_ok "$bin"; then
                        printf '%s\n' "$bin"
                        return 0
                    fi
                done
            done
            return 1
        }
        if ! node_bin=$(pick_node); then
            echo "pre-commit: 需要 Node 18+（项目推荐 24）才能跑 Prettier。先 nvm use 24" >&2
            fail=1
        else
            # shellcheck disable=SC2086
            if ! PATH="$(dirname "$node_bin"):$PATH" "$prettier" --write $webfiles; then
                echo "pre-commit: Prettier 格式化失败" >&2
                fail=1
            else
                # shellcheck disable=SC2086
                git add $webfiles
            fi
        fi
    fi
fi
exit $fail
