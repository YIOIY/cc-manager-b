#!/bin/sh
# Nobody may delete main or rewrite its history. Ordinary pushes to main are
# allowed for every developer. See CONTRIBUTING.md §3.
zero=0000000000000000000000000000000000000000
while read -r local_ref local_sha remote_ref remote_sha; do
    [ "$remote_ref" = refs/heads/main ] || continue
    if [ "$local_sha" = "$zero" ]; then
        echo "pre-push: 不允许删除 main 分支。" >&2
        exit 1
    fi
    if [ "$remote_sha" != "$zero" ] && ! git merge-base --is-ancestor "$remote_sha" "$local_sha" 2>/dev/null; then
        echo "pre-push: 这次推送会改写 main 的历史（强制推送），不允许。" >&2
        echo "  如果只是本地落后，先 git pull --rebase 再推。" >&2
        exit 1
    fi
done
exit 0
